{
  "name": "phot-ai-client-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Phot.AI Client Ops — B2B client management dashboard",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "tsx --test server/test/*.test.ts",
    "db:reset": "tsx server/scripts/reset.ts",
    "create-user": "tsx server/scripts/create-user.ts",
    "db:demo": "tsx server/scripts/reset.ts --demo"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.2",
    "multer": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
