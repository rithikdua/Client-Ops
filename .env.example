# Copy to .env and adjust. Every value has a development default except
# SESSION_SECRET, which the server refuses to run without in production.

# HTTP port for the API (the Vite dev server proxies /api here).
PORT=8787

# Signs session cookies. REQUIRED in production — without it, cookies would be
# forgeable. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# SQLite database file. Created on first run, along with its WAL sidecars.
DATABASE_PATH=server/data/client-ops.db

# Where uploaded attachments are written. Served back only to signed-in users.
UPLOAD_DIR=server/data/uploads

# Demo data is opt-in. Leave unset for a real workspace: the app then shows
# first-run setup so you create your own Owner account. Set to 1 to load the
# sample clients/teammates on an empty database instead.
SEED_DEMO_DATA=

# Password given to the demo accounts when demo data is loaded.
# Defaults to "demo1234" in development; required to seed in production.
SEED_PASSWORD=

# Set to "production" to enable secure cookies and the safety checks above.
NODE_ENV=development
