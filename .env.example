# Copy to .env and adjust. Every value has a development default except
# SESSION_SECRET, which the server refuses to run without in production.

# HTTP port for the API (the Vite dev server proxies /api here).
PORT=8787

# Signs session cookies. REQUIRED in production — without it, cookies would be
# forgeable. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The workspace's business timezone, as an IANA name. Every calendar day in the
# system is measured here — activity dates, follow-up due dates, and the date a
# form offers by default — so a server running in UTC and a team working in India
# never disagree about what "today" is. Must be set to where the business
# operates, not where the server happens to run.
WORKSPACE_TIMEZONE=Asia/Kolkata

# Serve the built front end from this server, so the app and the API share one
# origin. On automatically when NODE_ENV=production; requires "npm run build"
# first. Sharing an origin is what puts the Content-Security-Policy on the
# document rather than only on JSON responses, and leaves the Origin check with
# a single value to accept.
# SERVE_STATIC=1
# STATIC_DIR=dist

# SQLite database file. Created on first run, along with its WAL sidecars.
DATABASE_PATH=server/data/client-ops.db

# Where uploaded attachments are written. Every file is an owned record, and
# downloads are authorized against the client it belongs to.
UPLOAD_DIR=server/data/uploads

# Upload limits, in bytes. Per request, per account, and for the whole workspace,
# so one person cannot fill the disk. Leave commented for the defaults below; a
# blank or unparseable value is treated as unset rather than as zero, and an
# out-of-range one stops the server at startup instead of silently disabling
# uploads.
# MAX_UPLOAD_BYTES=10485760
# MAX_UPLOAD_BYTES_PER_USER=209715200
# MAX_UPLOAD_BYTES_TOTAL=2147483648

# Absolute URL the app is served from. Used to build password-reset links, and
# accepted as an origin for state-changing requests, so it must be the address
# people actually open — not the API's own port. In development it defaults to
# the Vite dev server; in production it has no default, and must be set whenever
# the front end is served from a different origin than the API.
APP_URL=http://localhost:5173

# Extra origins allowed to make state-changing requests, comma-separated. Only
# needed when more than one address serves the app (a staging hostname, a custom
# domain alongside the default one). The origin a request was addressed to is
# always accepted, so a single-origin deployment needs nothing here.
APP_ORIGINS=

# How long a password-reset link stays usable, in milliseconds. Default 1 hour,
# minimum 1 minute. Leave commented unless you mean to change it.
# PASSWORD_RESET_TTL_MS=3600000

# One-time code that first-run setup must present. REQUIRED in production: an
# unguarded /auth/setup on a public URL means whoever loads the page first
# becomes the Owner. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Leave blank or commented for local development.
SETUP_TOKEN=

# Demo data is opt-in. Leave unset for a real workspace: the app then shows
# first-run setup so you create your own Owner account. Set to 1 (or true/yes) to
# load the sample clients/teammates on an empty database instead. Anything that is
# not a recognised true/false value stops the server rather than being guessed at.
SEED_DEMO_DATA=

# Password given to the demo accounts when demo data is loaded.
# Defaults to "demo-pass-2026!" in development; required to seed in production.
SEED_PASSWORD=

# Minimum password length. The other rules — no common passwords, no character
# substitutions of them, nothing built from the account holder's own name or
# email, no sequential runs — are not configurable, because a deployment that
# turns them off has no policy at all.
# MIN_PASSWORD_LENGTH=12

# Check new passwords against Have I Been Pwned before accepting them. Off by
# default: it is an outbound request, which is a deployment decision. Only the
# first five characters of the password's SHA-1 hash are sent (k-anonymity), and
# the check fails open — if the service is unreachable the password is accepted
# and a warning is logged, because a password checker that blocks sign-up when a
# third party is down has turned a nice-to-have into an outage.
# PASSWORD_BREACH_CHECK=1

# --- Google sign-in (optional) ----------------------------------------------
# Leave these blank and the "Continue with Google" button simply does not appear.
#
# To enable it: Google Cloud Console -> APIs & Services -> Credentials ->
# Create credentials -> OAuth client ID -> Web application. Add the callback
# below to "Authorised redirect URIs", then paste the client ID and secret here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the redirect URI registered in Google Cloud *exactly*. It points at
# the address the browser sees: the Vite dev server in development, your real
# domain in production (https://clientops.example.com/api/auth/google/callback).
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Override only for testing: where Google's public signing keys are fetched from.
# Defaults to Google's real JWKS endpoint.
GOOGLE_JWKS_URL=

# Optional comma-separated allowlist. With this set, only Google accounts on
# these email domains can sign in at all — worth setting for a company tool.
GOOGLE_ALLOWED_DOMAINS=

# Set when a reverse proxy you control sets X-Forwarded-For and
# X-Forwarded-Proto. Leave BLANK otherwise: trusting a client-supplied header
# makes per-IP rate limiting worthless, since an attacker can send a different
# value each attempt — and would let one talk the server into sending HSTS.
TRUST_PROXY=

# Set to "production" to enable secure cookies and the safety checks above.
NODE_ENV=development
